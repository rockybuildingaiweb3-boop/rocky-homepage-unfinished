{
  "name": "rocky-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsx scripts/validateSkills.ts && vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','server.js'])fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/validateSkills.ts && tsx scripts/validateIcons.ts && tsx --test src/features/skills/livingOrbitEngine.test.ts src/features/scroll/performanceOptimization.test.ts",
    "validate:skills": "tsx scripts/validateSkills.ts",
    "validate:icons": "tsx scripts/validateIcons.ts",
    "optimize:flower": "node scripts/process-flower.cjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "detect-gpu": "^5.0.70",
    "motion": "^12.23.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "simple-icons": "^16.29.0",
    "tech-stack-icons": "^3.7.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
